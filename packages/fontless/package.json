{
  "name": "fontless",
  "type": "module",
  "version": "0.3.0",
  "description": "Magical plug-and-play font optimization for modern web applications",
  "author": {
    "name": "Daniel Roe",
    "email": "daniel@roe.dev",
    "url": "https://github.com/danielroe"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unjs/fontaine.git",
    "directory": "packages/fontless"
  },
  "keywords": [
    "font",
    "optimization",
    "vite-plugin",
    "css",
    "javascript"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./runtime": "./dist/runtime.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vitest dev",
    "lint": "eslint . --fix",
    "prepack": "pnpm --filter fontaine build && pnpm build",
    "test": "pnpm test:unit && pnpm test:types",
    "test-e2e": "playwright test",
    "test:unit": "vitest",
    "test:types": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "consola": "^3.4.2",
    "css-tree": "^3.1.0",
    "defu": "^6.1.4",
    "fontaine": "workspace:*",
    "jiti": "^2.6.1",
    "lightningcss": "^1.33.0",
    "magic-string": "^1.0.0",
    "ohash": "^2.0.11",
    "pathe": "^2.0.3",
    "ufo": "^1.6.1",
    "unifont": "^0.8.0",
    "unstorage": "^1.17.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/css-tree": "3.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "tinyexec": "1.3.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite7": "npm:vite@7.3.6",
    "vitest": "4.1.11"
  }
}
