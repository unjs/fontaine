{
  "name": "fontaine",
  "type": "module",
  "version": "0.8.0",
  "description": "Automatic font fallback based on font metrics",
  "author": {
    "name": "Daniel Roe",
    "email": "daniel@roe.dev",
    "url": "https://github.com/danielroe"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unjs/fontaine.git",
    "directory": "packages/fontaine"
  },
  "keywords": [
    "fonts",
    "cls",
    "web-vitals",
    "performance"
  ],
  "sideEffects": false,
  "imports": {
    "#capsize-font-metrics": "./dist/capsize-font-metrics.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./postcss": {
      "import": {
        "types": "./dist/postcss.d.mts",
        "default": "./dist/postcss.mjs"
      },
      "require": {
        "types": "./dist/postcss.d.cts",
        "default": "./dist/postcss.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vitest",
    "demo": "vite dev playground",
    "demo:dev": "pnpm demo --config test/vite.config.mjs",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "test": "pnpm test:unit && pnpm test:types",
    "test:types": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "postcss": "^8.4.31"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@capsizecss/unpack": "^4.0.0",
    "css-tree": "^3.1.0",
    "magic-regexp": "^0.11.0",
    "magic-string": "^1.0.0",
    "pathe": "^2.0.3",
    "ufo": "^1.6.1",
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@capsizecss/metrics": "4.2.0",
    "@types/css-tree": "3.2.0",
    "@types/node": "24.13.3",
    "@types/serve-handler": "6.1.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "get-port-please": "3.2.0",
    "postcss": "8.5.26",
    "serve-handler": "6.1.7",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
